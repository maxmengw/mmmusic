generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  clerkId       String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  koreanMusics  KoreanMusic[]
  chineseMusics ChineseMusic[]
  filipinoMusics FilipinoMusic[]
  youtubeMusics YouTubeMusic[]
  playlistItems PlaylistItem[]
}

model KoreanMusic {
  id          String   @id @default(uuid())
  name        String
  description String
  examples    Json
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChineseMusic {
  id          String   @id @default(uuid())
  name        String
  description String
  examples    Json
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FilipinoMusic {
  id          String   @id @default(uuid())
  name        String
  description String
  examples    Json
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model YouTubeMusic {
  id            String         @id @default(uuid())
  title         String
  artist        String
  videoId       String
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistItems PlaylistItem[]

  @@unique([videoId, userId])
}

model PlaylistItem {
  id             String       @id @default(uuid())
  youtubeMusicId String
  youtubeMusic   YouTubeMusic @relation(fields: [youtubeMusicId], references: [id])
  position       Int?
  name           String?
  createdAt      DateTime     @default(now())
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
}
