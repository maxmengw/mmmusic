{
    "engines": {
        "node": "22.x"
    },
    "installCommand": "npm install --force",
    "buildCommand": "npm run vercel-build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "git": {
        "deploymentEnabled": {
            "*": false,
            "main": true
        }
    }
}